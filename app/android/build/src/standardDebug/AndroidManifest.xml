<?xml version="1.0" encoding="utf-8"?>
<!-- ML2 fix: Godot uses a GodotAppLauncher alias as the LAUNCHER entry point.
     Launching via the alias causes XR_ERROR_RUNTIME_FAILURE on ML2 because the
     OpenXR runtime sees the alias component name instead of the real activity.
     This overlay removes the alias and puts LAUNCHER directly on GodotApp.

     This file is a variant-specific manifest (standardDebug) which has higher
     priority than src/debug/ in the Android manifest merger, and is NOT
     regenerated by Godot's export. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Remove the alias so ML2 home launches GodotApp directly -->
        <activity-alias
            android:name=".GodotAppLauncher"
            tools:node="remove" />

        <!-- Godot's mergeOnlyAttributes on the activity in src/debug/ blocks
             child elements from lower-priority manifests, so we must provide
             the complete set of intent-filters here. -->
        <activity android:name=".GodotApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
                <category android:name="com.magicleap.intent.category.IMMERSIVE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
