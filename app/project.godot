; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EntanglCopilot"
run/main_scene="uid://cr2ecfpaecnev"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

PanelRouter="*res://ui/panelrouter/panel_router.gd"
KeyboardManager="*res://scripts/KeyboardManager.gd"
NoteManager="*res://scripts/NoteManager.gd"
XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"
Supabase="*uid://ocnh0cal4jt1"
SupabaseManager="*uid://bkm7clkns3jgq"

[display]

window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="EntanglCopilot"

[editor_plugins]

enabled=PackedStringArray("res://addons/cv_camera/plugin.cfg", "res://addons/godot-xr-tools/plugin.cfg", "res://addons/supabase/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/InterVariable.tres"
theme/default_font_size=28

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/reference_space=1
openxr/environment_blend_mode=1
openxr/extensions/hand_tracking=true
openxr/extensions/hand_interaction_profile=true
shaders/enabled=true
openxr/enabled.android=true
openxr/extensions/magic_leap/spatial_anchors=true
openxr/extensions/magic_leap/localization_map=true
openxr/extensions/magic_leap/plane_detection=true
openxr/extensions/magic_leap/world_mesh_detection=true
