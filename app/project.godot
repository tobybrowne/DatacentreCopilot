; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EntanglCopilot"
run/main_scene="uid://cr2ecfpaecnev"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"
Supabase="*uid://ocnh0cal4jt1"
SupabaseManager="*uid://cu146gf6hduem"

[display]

window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="EntanglCopilot"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/supabase/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/reference_space=1
openxr/environment_blend_mode=1
openxr/extensions/hand_tracking=true
openxr/extensions/hand_interaction_profile=true
shaders/enabled=true
openxr/extensions/magic_leap/spatial_anchors=true
openxr/extensions/magic_leap/localization_map=true
